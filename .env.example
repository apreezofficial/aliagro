APP_NAME=AliAgro
APP_ENV=local
# Generate with: php bin/key-generate.php
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Comma separated origins allowed by CORS, or * for any
CORS_ALLOWED_ORIGINS=*
# Set true only behind a trusted reverse proxy / load balancer (uses X-Forwarded-For)
TRUST_PROXY=false

BCRYPT_ROUNDS=12
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aliagro_db
DB_USERNAME=root
DB_PASSWORD=

# log (write mails to storage/logs) | smtp | mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# ssl (port 465) | tls (port 587) | leave empty to auto-detect
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
